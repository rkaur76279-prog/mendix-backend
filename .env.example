PORT=5000
MONGO_URI=mongodb://localhost:27017/mendx
JWT_SECRET=your_jwt_super_secret_production_key_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# OTP Security Configuration
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_SECRET=optional_dedicated_secret_for_otp_hmac_hashing

# SMTP Email Configuration (Nodemailer)
# If left blank in development, automated fallback test delivery is used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Mendx Security" <noreply@mendx.com>

